                "combinator": "and"
              },
              "outputKey": "טקסט"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "loose" },
                "conditions": [
                  { "leftValue": "={{ $json.messages[0].type }}", "rightValue": "image|document", "operator": { "type": "string", "operation": "regex" } }
                ],
                "combinator": "and"
              },
              "outputKey": "חשבונית (תמונה/קובץ)"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "switch-type",
      "name": "טקסט או חשבונית?",
