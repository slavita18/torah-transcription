      "position": [90, 340],
      "credentials": { "anthropicApi": { "id": "REPLACE_ANTHROPIC_CRED_ID", "name": "Anthropic account" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "b1", "name": "userMessage", "value": "=קיבלתי חשבונית/קבלה מספק. הנתונים שחולצו: {{ $json.text }}. חפש בישות \"דיווחי עבודה\" את הרשומות של אותו ספק שתואמות לחשבונית (לפי הסכום/התאריך), וסמן על כל רשומה תואמת \"קבלה\"=כן ו\"אסמכתא\"=מספר החשבונית. בסיום דווח לי בקצרה מה סימנת.", "type": "string" },
