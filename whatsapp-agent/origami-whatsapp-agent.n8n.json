            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "loose" },
                "conditions": [
                  { "leftValue": "={{ $json.messages[0].type }}", "rightValue": "text", "operator": { "type": "string", "operation": "equals" } }
