    {
      "parameters": {
        "jsCode": "const rows = Array.isArray($json.data) ? $json.data : ($json.data ? [$json.data] : (Array.isArray($json) ? $json : []));\nconst title = (t) => t['כותרת'] || t.title || t.name || 'משימה';\nconst due = (t) => t['תאריך יעד'] || t.due_date;\nlet body;\nif (!rows.length) {\n  body = 'בוקר טוב! ☀️ אין משימות פתוחות היום. 🎉';\n} else {\n  const lines = rows.map((t, i) => `${i + 1}. ${title(t)}${due(t) ? ' (יעד: ' + due(t) + ')' : ''}`);\n  body = 'בוקר טוב! ☀️ יש לך ' + rows.length + ' משימות פתוחות:\\n\\n' + lines.join('\\n') + '\\n\\nמה לעשות? ענה לי בחופשיות (למשל: \"סגור 1 ו-3, דחה את 2 למחר\").';\n}\nreturn [{ json: { body } }];"
      },
