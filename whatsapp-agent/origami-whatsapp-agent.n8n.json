            { "id": "b1", "name": "userMessage", "value": "=קיבלתי חשבונית מספק. הנתונים שחולצו מהחשבונית: {{ $json.text }}. חפש באוריגמי את התשלומים לאותו ספק שתואמים לחשבונית (לפי סכום/תאריך), וסמן על כל תשלום תואם שהתקבלה חשבונית (מספר החשבונית). בסיום דווח לי מה סימנת.", "type": "string" },
